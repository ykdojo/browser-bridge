{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.6.3",
  "description": "Lets a local MCP server control the tabs in this browser.",
  "key": "",
  "permissions": ["debugger", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Browser Bridge", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } }
}
